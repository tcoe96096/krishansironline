VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Explicit opt-in; keep false until secure backend and database are live.
VITE_RESULT_CARD_BACKEND_ENABLED=false
