# Copy to .env.local for local development.
# These are public browser values; never put service-role or secret keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Core Teacher Beta: availability defaults off. Server gates remain authoritative.
VITE_TEACHER_BETA_ENABLED=false
VITE_TEACHER_ADVANCED_ENABLED=false
VITE_TEACHER_RESULT_ANALYTICS_ENABLED=false
VITE_TEACHER_RESUME_ENABLED=false
